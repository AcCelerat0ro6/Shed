# RAG 元数据数据库。本机运行使用回环地址，容器部署时填写服务名。
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=my_pi_agent

# 文本检索使用单个 Elasticsearch 8 索引。按部署填写认证信息。
RETRIEVE_DRIVER=elasticsearch_v8
ELASTICSEARCH_ADDR=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=my_pi_docs
